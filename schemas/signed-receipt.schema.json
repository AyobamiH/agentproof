{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproof.dev/schemas/2.0.0/signed-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "proof"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaId",
        "schemaVersion",
        "receiptFormatVersion",
        "actionType",
        "receiptId",
        "issuedAt",
        "transactionId",
        "correlationId",
        "intentDigest",
        "actionDigest",
        "preparedActionDigest",
        "repositoryRoot",
        "repositoryRootDigest",
        "repositoryIdentity",
        "authorityEnvironment",
        "policyVersion",
        "approvalBinding",
        "approvalBindingDigest",
        "approvalDecisionDigest",
        "approvalAuthorityEvidence",
        "beforeStateDigest",
        "proposedStateDigest",
        "observedStateDigest",
        "executionState",
        "verificationState",
        "compensationState",
        "evidenceDigests",
        "signerRole",
        "signingPolicyId",
        "predecessorPayloadDigest",
        "evidence"
      ],
      "properties": {
        "schemaId": {
          "const": "agentproof.signed-receipt.v2"
        },
        "schemaVersion": {
          "const": "2.0.0"
        },
        "receiptFormatVersion": {
          "const": "v2"
        },
        "actionType": {
          "const": "agentproof.repository_patch.v1"
        },
        "receiptId": {
          "type": "string",
          "minLength": 1
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "transactionId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        },
        "intentDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "preparedActionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRootDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repositoryIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalRoot",
            "gitDirectorySha256",
            "baseCommit",
            "branch",
            "headRef",
            "remotesDigest",
            "refsDigest"
          ],
          "properties": {
            "canonicalRoot": {
              "type": "string",
              "minLength": 1
            },
            "gitDirectorySha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "baseCommit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "headRef": {
              "type": "string",
              "minLength": 1
            },
            "remotesDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "refsDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "authorityEnvironment": {
          "enum": [
            "development",
            "production"
          ]
        },
        "policyVersion": {
          "const": "agentproof.repository-patch.v1"
        },
        "approvalBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaId",
            "transactionId",
            "correlationId",
            "originalTaskId",
            "approvalTaskId",
            "approvalDecisionId",
            "approvedFromTaskId",
            "intentDigest",
            "actionDigest",
            "preparedActionDigest",
            "repositoryRoot",
            "repositoryRootDigest",
            "baseCommit",
            "beforeStateDigest",
            "proposedStateDigest",
            "affectedPaths",
            "policyVersion",
            "issuer",
            "decision",
            "decidedAt",
            "expiresAt",
            "authorityEnvironment",
            "nonce"
          ],
          "properties": {
            "schemaId": {
              "const": "agentproof.approval-binding.v2"
            },
            "transactionId": {
              "type": "string",
              "minLength": 1
            },
            "correlationId": {
              "type": "string",
              "minLength": 1
            },
            "originalTaskId": {
              "type": "string",
              "minLength": 1
            },
            "approvalTaskId": {
              "type": "string",
              "minLength": 1
            },
            "approvalDecisionId": {
              "type": "string",
              "minLength": 1
            },
            "approvedFromTaskId": {
              "type": "string",
              "minLength": 1
            },
            "intentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "actionDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "preparedActionDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "repositoryRoot": {
              "type": "string",
              "minLength": 1
            },
            "repositoryRootDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "baseCommit": {
              "type": "string",
              "minLength": 1
            },
            "beforeStateDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "proposedStateDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "affectedPaths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "policyVersion": {
              "type": "string",
              "minLength": 1
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "const": "approved"
            },
            "decidedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "authorityEnvironment": {
              "enum": [
                "development",
                "production"
              ]
            },
            "nonce": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "approvalBindingDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvalDecisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvalAuthorityEvidence": {
          "const": "receipt_signer_attests_portable_authority_verified"
        },
        "beforeStateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposedStateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observedStateDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "executionState": {
          "enum": [
            "executed",
            "partially_executed",
            "failed",
            null
          ]
        },
        "verificationState": {
          "enum": [
            "verified",
            "failed",
            "uncertain",
            null
          ]
        },
        "compensationState": {
          "enum": [
            "compensated",
            "escalation_required",
            null
          ]
        },
        "evidenceDigests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readOnlyEvidenceDigest",
            "executionEvidenceDigest",
            "verificationEvidenceDigest",
            "compensationEvidenceDigest"
          ],
          "properties": {
            "readOnlyEvidenceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "executionEvidenceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "verificationEvidenceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "compensationEvidenceDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "signerRole": {
          "const": "independent_receipt_signer"
        },
        "signingPolicyId": {
          "type": "string",
          "minLength": 1
        },
        "predecessorPayloadDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "affectedPaths",
            "beforeManifest",
            "proposedManifest",
            "observedManifest",
            "readOnlyEvidence",
            "execution",
            "verification",
            "compensation"
          ],
          "properties": {
            "intent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "summary",
                "requestedBy",
                "acceptanceCriteria"
              ],
              "properties": {
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "requestedBy": {
                  "type": "string",
                  "minLength": 1
                },
                "acceptanceCriteria": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "affectedPaths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "beforeManifest": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "mode",
                  "sha256",
                  "byteLength",
                  "exists",
                  "tracked"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "tracked": {
                    "type": "boolean"
                  }
                }
              }
            },
            "proposedManifest": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "mode",
                  "sha256",
                  "byteLength",
                  "exists",
                  "tracked"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "tracked": {
                    "type": "boolean"
                  }
                }
              }
            },
            "observedManifest": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "mode",
                  "sha256",
                  "byteLength",
                  "exists",
                  "tracked"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "byteLength": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "tracked": {
                    "type": "boolean"
                  }
                }
              }
            },
            "readOnlyEvidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "provider",
                  "command",
                  "status",
                  "success",
                  "resultDigest"
                ],
                "properties": {
                  "provider": {
                    "const": "coding-agent-skills"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1
                  },
                  "success": {
                    "type": "boolean"
                  },
                  "resultDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "execution": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "attemptedAt",
                    "completedAt",
                    "message"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "executed",
                        "partially_executed",
                        "failed"
                      ]
                    },
                    "attemptedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "completedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "executorProcessId": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "verification": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "observedManifest",
                    "observedPaths",
                    "observedDiffDigest",
                    "identityUnchanged",
                    "unexpectedUntrackedPaths",
                    "commands",
                    "message"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "verified",
                        "failed",
                        "uncertain"
                      ]
                    },
                    "observedManifest": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "mode",
                          "sha256",
                          "byteLength",
                          "exists",
                          "tracked"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "mode": {
                            "enum": [
                              "100644",
                              "100755"
                            ]
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "byteLength": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "exists": {
                            "type": "boolean"
                          },
                          "tracked": {
                            "type": "boolean"
                          }
                        }
                      }
                    },
                    "observedPaths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "observedDiffDigest": {
                      "oneOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "identityUnchanged": {
                      "type": "boolean"
                    },
                    "unexpectedUntrackedPaths": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "commands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "executable",
                          "args",
                          "cwd",
                          "exitCode",
                          "timedOut",
                          "durationMs",
                          "stdoutDigest",
                          "stderrDigest",
                          "stdoutBytes",
                          "stderrBytes",
                          "truncated",
                          "sanitized"
                        ],
                        "properties": {
                          "executable": {
                            "type": "string",
                            "minLength": 1
                          },
                          "args": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "cwd": {
                            "type": "string",
                            "minLength": 1
                          },
                          "exitCode": {
                            "type": [
                              "integer",
                              "null"
                            ]
                          },
                          "timedOut": {
                            "type": "boolean"
                          },
                          "durationMs": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "stdoutDigest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "stderrDigest": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "stdoutBytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "stderrBytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "truncated": {
                            "type": "boolean"
                          },
                          "sanitized": {
                            "const": true
                          }
                        }
                      }
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "compensation": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "state",
                    "message",
                    "verifiedAt"
                  ],
                  "properties": {
                    "state": {
                      "enum": [
                        "compensated",
                        "escalation_required"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verifiedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "Z$"
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "publicKeyPem",
        "signerFingerprint",
        "payloadDigest",
        "signatureBase64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "publicKeyPem": {
          "type": "string",
          "pattern": "^-----BEGIN PUBLIC KEY-----"
        },
        "signerFingerprint": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "signatureBase64": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    }
  }
}
