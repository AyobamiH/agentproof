{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproof.dev/schemas/2.0.0/agent-proof-error.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "actionType",
    "correlationId",
    "code",
    "message",
    "retryable"
  ],
  "properties": {
    "schema": {
      "const": "agentproof.protocol.error"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "actionType": {
      "const": "agentproof.repository_patch.v1"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    }
  }
}
