{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproof.dev/schemas/2.0.0/repository-patch-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "actionType",
    "correlationId",
    "stateDirectory",
    "action",
    "intent",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "agentproof.protocol.repository-patch-request"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "actionType": {
      "const": "agentproof.repository_patch.v1"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "stateDirectory": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "repositoryRoot",
        "operations"
      ],
      "properties": {
        "type": {
          "const": "agentproof.repository_patch.v1"
        },
        "repositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path",
                  "contentBase64"
                ],
                "properties": {
                  "kind": {
                    "const": "write"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contentBase64": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  },
                  "mode": {
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  "newFile": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "const": "delete"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "verificationCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "args",
              "cwd",
              "timeoutMs",
              "maxOutputBytes"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 120000
              },
              "maxOutputBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1048576
              }
            }
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "requestedBy",
        "acceptanceCriteria"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requestedBy": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedRepositoryRoot",
        "allowedTrackedPaths",
        "allowedNewPaths",
        "maxPatchBytes",
        "maxFiles"
      ],
      "properties": {
        "allowedRepositoryRoot": {
          "type": "string",
          "minLength": 1
        },
        "allowedTrackedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedNewPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowSecretBearingPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedVerificationExecutables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "allowedVerificationWorkingDirectories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "maxPatchBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
