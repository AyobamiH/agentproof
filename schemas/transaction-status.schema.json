{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentproof.dev/schemas/2.0.0/transaction-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "actionType",
    "correlationId",
    "transactionId",
    "state",
    "receiptPersisted",
    "lastError"
  ],
  "properties": {
    "schema": {
      "const": "agentproof.protocol.transaction-status"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "actionType": {
      "const": "agentproof.repository_patch.v1"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "transactionId": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "approval_required",
        "blocked",
        "prepared",
        "executing",
        "executed",
        "partially_executed",
        "verified",
        "failed",
        "uncertain",
        "compensated",
        "escalation_required"
      ]
    },
    "receiptPersisted": {
      "type": "boolean"
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
