{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentProof adoption observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "participantId",
    "evidenceKind",
    "unfamiliarWithAgentProof",
    "artifact",
    "environment",
    "startedAt",
    "completedAt",
    "firstTrustedReceiptAt",
    "commandsAttempted",
    "firstBlocker",
    "assistanceRequired",
    "confusingTerms",
    "trustRoles",
    "outcomes",
    "intentToIntegrate",
    "nextProtectedAction",
    "paymentPreference",
    "adoptionChangingRepair",
    "rawEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordId": {
      "$ref": "#/definitions/id"
    },
    "participantId": {
      "$ref": "#/definitions/id"
    },
    "evidenceKind": {
      "enum": [
        "independent_agent",
        "maintainer_engineering"
      ]
    },
    "unfamiliarWithAgentProof": {
      "type": "boolean"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "sourceCommit",
        "sha256",
        "integrity"
      ],
      "properties": {
        "name": {
          "const": "@oneclicksystems/agentproof"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        },
        "integrity": {
          "type": "string",
          "pattern": "^sha512-[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "node",
        "agent"
      ],
      "properties": {
        "platform": {
          "$ref": "#/definitions/text"
        },
        "node": {
          "type": "string",
          "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "agent": {
          "$ref": "#/definitions/text"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "firstTrustedReceiptAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "commandsAttempted": {
      "$ref": "#/definitions/texts"
    },
    "firstBlocker": {
      "$ref": "#/definitions/nullableText"
    },
    "assistanceRequired": {
      "$ref": "#/definitions/texts"
    },
    "confusingTerms": {
      "$ref": "#/definitions/texts"
    },
    "trustRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposer",
        "approvalAuthority",
        "executor",
        "receiptSigner",
        "offlineVerifier"
      ],
      "properties": {
        "proposer": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "approvalAuthority": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "executor": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "receiptSigner": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "offlineVerifier": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation",
        "lifecycle",
        "independentReceiptVerification",
        "exactlyOnce",
        "compensation",
        "criticalAmbiguity"
      ],
      "properties": {
        "installation": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "lifecycle": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "independentReceiptVerification": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "exactlyOnce": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "compensation": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_OBSERVED"
          ]
        },
        "criticalAmbiguity": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "intentToIntegrate": {
      "enum": [
        "yes",
        "no",
        "undecided",
        "not_asked"
      ]
    },
    "nextProtectedAction": {
      "$ref": "#/definitions/nullableText"
    },
    "paymentPreference": {
      "$ref": "#/definitions/nullableText"
    },
    "adoptionChangingRepair": {
      "$ref": "#/definitions/nullableText"
    },
    "rawEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "sha256"
        ],
        "properties": {
          "reference": {
            "$ref": "#/definitions/text"
          },
          "sha256": {
            "$ref": "#/definitions/sha256"
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "nullableText": {
      "anyOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "texts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/text"
      }
    }
  }
}
